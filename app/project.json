{
  "name": "zzz-frontend",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "app/src",
  "tags": ["scope:zzz", "layer:app"],
  "// targets": "to see all targets run: nx show project zzz-frontend --web",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/app"],
      "options": {
        "command": "bun test --jsdom --timeout=60000",
        "cwd": "app"
      }
    },
    "gen-file": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node app/src/page-optimize/scripts/gen-da-seasons.mjs",
          "node app/src/page-optimize/scripts/gen-sd-seasons.mjs",
          "bun app/src/goonCorner/scripts/gen-bookmarks.ts"
        ],
        "parallel": true
      },
      "outputs": [
        "{projectRoot}/src/page-optimize/daSeasons_gen.json",
        "{projectRoot}/src/page-optimize/shiyuSeasons_gen.json",
        "{projectRoot}/src/goonCorner/tweets_gen.ts"
      ]
    }
  },
  "implicitDependencies": ["common-localization"]
}
