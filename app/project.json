{
  "name": "zzz-frontend",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "app/src",
  "tags": [],
  "// targets": "to see all targets run: nx show project zzz-frontend --web",
  "targets": {
    "build": {
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/app"],
      "options": {
        "command": "bun test --jsdom --timeout=60000",
        "cwd": "app"
      }
    }
  },
  "implicitDependencies": ["common-localization"]
}
