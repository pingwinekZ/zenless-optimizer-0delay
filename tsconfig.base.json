{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2021", "dom"],
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "strictNullChecks": true,
    "typeRoots": ["./node_modules/@types", "./node_modules", "./types"],
    "paths": {
      "@zenless-optimizer/common/ad": ["./packages/common/ad/src/index.ts"],
      "@zenless-optimizer/common/database": [
        "./packages/common/database/src/index.ts"
      ],
      "@zenless-optimizer/common/database-ui": [
        "./packages/common/database-ui/src/index.ts"
      ],
      "@zenless-optimizer/common/img-util": [
        "./packages/common/img-util/src/index.ts"
      ],
      "@zenless-optimizer/common/localization": [
        "./packages/common/localization/src/index.ts"
      ],
      "@zenless-optimizer/common/pipeline": [
        "./packages/common/pipeline/src/index.ts"
      ],
      "@zenless-optimizer/common/plugin": [
        "./packages/common/plugin/src/index.ts"
      ],
      "@zenless-optimizer/common/react-util": [
        "./packages/common/react-util/src/index.ts"
      ],
      "@zenless-optimizer/common/svgicons": [
        "./packages/common/svgicons/src/index.ts"
      ],
      "@zenless-optimizer/common/ui": ["./packages/common/ui/src/index.ts"],
      "@zenless-optimizer/common/util": ["./packages/common/util/src/index.ts"],
      "@zenless-optimizer/game-opt/engine": [
        "./packages/game-opt/engine/src/index.ts"
      ],
      "@zenless-optimizer/game-opt/formula": [
        "./packages/game-opt/formula/src/index.ts"
      ],
      "@zenless-optimizer/game-opt/formula-ui": [
        "./packages/game-opt/formula-ui/src/index.ts"
      ],
      "@zenless-optimizer/game-opt/sheet-ui": [
        "./packages/game-opt/sheet-ui/src/index.ts"
      ],
      "@zenless-optimizer/game-opt/solver": [
        "./packages/game-opt/solver/src/index.ts"
      ],
      "@zenless-optimizer/game-opt/solver-webgpu": [
        "./packages/game-opt/solver-webgpu/src/index.ts"
      ],
      "@zenless-optimizer/pando/engine": [
        "./packages/pando/engine/src/index.ts"
      ],
      "@zenless-optimizer/zzz/assets": ["./packages/zzz/assets/src/index.ts"],
      "@zenless-optimizer/zzz/assets/*": ["./packages/zzz/assets/src/*"],
      "@zenless-optimizer/zzz/assets-data": [
        "./packages/zzz/assets-data/src/index.ts"
      ],
      "@zenless-optimizer/zzz/assets-data/*": [
        "./packages/zzz/assets-data/src/*"
      ],
      "@zenless-optimizer/zzz/consts": ["./packages/zzz/consts/src/index.ts"],
      "@zenless-optimizer/zzz/consts/*": ["./packages/zzz/consts/src/*"],
      "@zenless-optimizer/zzz/db": ["./app/src/db/index.ts"],
      "@zenless-optimizer/zzz/db/*": ["./app/src/db/*"],
      "@zenless-optimizer/zzz/db-ui": ["./app/src/db-ui/index.ts"],
      "@zenless-optimizer/zzz/db-ui/*": ["./app/src/db-ui/*"],
      "@zenless-optimizer/zzz/disc-scanner": [
        "./packages/zzz/disc-scanner/src/index.ts"
      ],
      "@zenless-optimizer/zzz/disc-scanner/*": [
        "./packages/zzz/disc-scanner/src/*"
      ],
      "@zenless-optimizer/zzz/dm": ["./app/src/dm/index.ts"],
      "@zenless-optimizer/zzz/dm/*": ["./app/src/dm/*"],
      "@zenless-optimizer/zzz/dm-localization": [
        "./packages/zzz/dm-localization/src/index.ts"
      ],
      "@zenless-optimizer/zzz/dm-localization/*": [
        "./packages/zzz/dm-localization/src/*"
      ],
      "@zenless-optimizer/zzz/formula": ["./app/src/formula/index.ts"],
      "@zenless-optimizer/zzz/formula/*": ["./app/src/formula/*"],
      "@zenless-optimizer/zzz/formula-ui": ["./app/src/formula-ui/index.ts"],
      "@zenless-optimizer/zzz/formula-ui/*": ["./app/src/formula-ui/*"],
      "@zenless-optimizer/zzz/i18n": ["./packages/zzz/i18n/src/index.ts"],
      "@zenless-optimizer/zzz/i18n/*": ["./packages/zzz/i18n/src/*"],
      "@zenless-optimizer/zzz/localization": [
        "./packages/zzz/localization/src/index.ts"
      ],
      "@zenless-optimizer/zzz/localization/*": [
        "./packages/zzz/localization/src/*"
      ],
      "@zenless-optimizer/zzz/page-home": ["./app/src/page-home/index.tsx"],
      "@zenless-optimizer/zzz/page-home/*": ["./app/src/page-home/*"],
      "@zenless-optimizer/zzz/page-settings": [
        "./app/src/page-settings/index.tsx"
      ],
      "@zenless-optimizer/zzz/page-settings/*": ["./app/src/page-settings/*"],
      "@zenless-optimizer/zzz/page-wengines": [
        "./app/src/page-wengines/index.tsx"
      ],
      "@zenless-optimizer/zzz/page-wengines/*": ["./app/src/page-wengines/*"],
      "@zenless-optimizer/zzz/rendering/*": ["./packages/zzz/rendering/src/*"],
      "@zenless-optimizer/zzz/schema": ["./app/src/schema/index.ts"],
      "@zenless-optimizer/zzz/schema/*": ["./app/src/schema/*"],
      "@zenless-optimizer/zzz/solver": ["./app/src/solver/index.ts"],
      "@zenless-optimizer/zzz/solver/*": ["./app/src/solver/*"],
      "@zenless-optimizer/zzz/stats": ["./packages/zzz/stats/src/index.ts"],
      "@zenless-optimizer/zzz/stats/*": ["./packages/zzz/stats/src/*"],
      "@zenless-optimizer/zzz/svgicons": [
        "./packages/zzz/svgicons/src/index.ts"
      ],
      "@zenless-optimizer/zzz/svgicons/*": ["./packages/zzz/svgicons/src/*"],
      "@zenless-optimizer/zzz/theme": ["./packages/zzz/theme/src/index.ts"],
      "@zenless-optimizer/zzz/theme/*": ["./packages/zzz/theme/src/*"],
      "@zenless-optimizer/zzz/ui": ["./app/src/ui/index.tsx"],
      "@zenless-optimizer/zzz/ui/*": ["./app/src/ui/*"],
      "@zenless-optimizer/zzz/util": ["./packages/zzz/util/src/index.ts"],
      "@zenless-optimizer/zzz/util/*": ["./packages/zzz/util/src/*"],
      "@zenless-optimizer/zzz/websocket/*": ["./packages/zzz/websocket/src/*"],
      "@zenless-optimizer/zzz/zood": ["./app/src/zood/index.ts"],
      "@zenless-optimizer/zzz/zood/*": ["./app/src/zood/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
