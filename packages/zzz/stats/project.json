{
  "name": "zzz-stats",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/zzz/stats/src",
  "projectType": "library",
  "tags": ["scope:zzz", "layer:domain"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p app/tsconfig.app.json",
        "cwd": "."
      }
    },
    "gen-file": {
      "executor": "@zenless-optimizer/zzz/stats:gen-stats",
      "outputs": [
        "{projectRoot}/src/Data/**/*",
        "{projectRoot}/src/allStat_gen.json"
      ],
      "inputs": ["default"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --timeout=60000",
        "cwd": "packages/zzz/stats"
      }
    }
  }
}
