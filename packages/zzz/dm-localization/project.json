{
  "name": "zzz-dm-localization",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/zzz/dm-localization/src",
  "projectType": "library",
  "tags": ["scope:zzz", "layer:domain"],
  "targets": {
    "gen-file": {
      "executor": "@zenless-optimizer/zzz/dm-localization:gen-locale",
      "outputs": ["{projectRoot}/src/assets/locales"],
      "inputs": ["default"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --timeout=60000",
        "cwd": "packages/zzz/dm-localization"
      }
    }
  }
}
